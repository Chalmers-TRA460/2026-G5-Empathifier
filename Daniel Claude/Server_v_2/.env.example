ANTHROPIC_API_KEY=your-key-here
PORT=3000

# When DEV_MODE=true the doctor sees the clinical sanity-check banner
# (notes-vs-standard-practice flagging). Off in production.
DEV_MODE=false

# Set to false to skip the sanity-check agent even in dev mode (saves tokens).
# Has no effect when DEV_MODE=false.
ENABLE_SANITY_CHECKER=true
